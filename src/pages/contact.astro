---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { serviceOptions } from '../data/services';
---
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Beställ - Tjelvar Hemservice</title>
	</head>
	<body>
		<header>
			<h1>Beställ</h1>
		</header>
		<main>
			<Nav />

			<!-- FORM -->
			<form name="contact" method="POST" data-netlify="true">
				<label for="name">Namn:</label>
				<input type="text" id="name" name="name" required />

				<label for="email">Email:</label>
				<input type="email" id="email" name="email" required />

				<label for="phone">Telefonnummer:</label>
				<input type="tel" id="phone" name="phone" required />

				<label>Typ av kund:</label>
				<div class="radio-group">
					<input type="radio" id="private" name="customer_type" value="privat" checked />
					<label for="private">Privat person</label>
					<input type="radio" id="business" name="customer_type" value="företag" />
					<label for="business">Företag</label>
				</div>

				<label for="service_type">Typ av tjänst:</label>
				<select id="service_type" name="service_type" required>
					<option value="">Välj tjänst</option>
					{serviceOptions.map((service) => (
						<option value={service.value}>{service.label}</option>
					))}
				</select>

				<label for="rooms">Antal rum:</label>
				<input type="number" id="rooms" name="rooms" min="1" />

				<label for="kvm">Kvm:</label>
				<input type="number" id="kvm" name="kvm" min="1" />

				<label for="frequency">Frekvens:</label>
				<input type="text" id="frequency" name="frequency" />

				<label for="info">Övrig info:</label>
				<textarea id="info" name="info"></textarea>

				<button type="submit">Skicka</button>
			</form>
			<div class="price-estimate" aria-live="polite">
				<p>Beräknat pris</p>
				<p id="estimate-value">Fyll i tjänst och kvm för pris</p>
			</div>
			<div id="success-message" style="display: none; margin-top: 2rem; padding: 1rem; background: var(--card-bg); border-radius: 1rem; box-shadow: var(--shadow); text-align: center;">
				<p>Tack för din beställning! Vi hör av oss inom en arbetsdag. Vid frågor var god att maila till <a href="mailto:kontakt@tjelvarstadservice.se">kontakt@tjelvarstadservice.se</a></p>
			</div>
		</main>
		<script define:vars={{ serviceOptions }}>
			const serviceMap = new Map(serviceOptions.map((service) => [service.value, service]));
			const serviceSelect = document.getElementById('service_type');
			const kvmInput = document.getElementById('kvm');
			const estimateValue = document.getElementById('estimate-value');

			const updateEstimate = () => {
				if (!serviceSelect || !kvmInput || !estimateValue) return;

				const selectedService = serviceMap.get(serviceSelect.value);
				const kvm = Number(kvmInput.value);

				if (!selectedService || Number.isNaN(kvm) || kvm <= 0) {
					estimateValue.textContent = 'Fyll i tjänst och kvm för pris';
					return;
				}

				if (selectedService.pricePerSqm <= 0) {
					estimateValue.textContent = 'Pris saknas för vald tjänst';
					return;
				}

				const estimate = selectedService.pricePerSqm * kvm;
				estimateValue.textContent = `${estimate.toLocaleString('sv-SE')} kr`;
			};

			serviceSelect?.addEventListener('change', updateEstimate);
			kvmInput?.addEventListener('input', updateEstimate);
			updateEstimate();

			document.querySelector('form')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = e.target instanceof HTMLFormElement ? e.target : null;
				if (!form) return;
				const formData = new FormData(form);
				try {
					const response = await fetch('/', {
						method: 'POST',
						body: formData,
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
					});
					if (response.ok) {
						form.style.display = 'none';
						const successMsg = document.getElementById('success-message');
						if (successMsg) successMsg.style.display = 'block';
					} else {
						alert('Något gick fel. Försök igen.');
					}
				} catch (error) {
					alert('Något gick fel. Försök igen.');
				}
			});
		</script>
		<style>
			form > label:not(:first-of-type) {
				margin-top: 1rem;
			}

			.price-estimate {
				margin-top: 2rem;
				padding: 1rem;
				background: var(--card-bg);
				border-radius: 1rem;
				box-shadow: var(--shadow);
				text-align: center;
			}
		</style>
	</body>
</html>
